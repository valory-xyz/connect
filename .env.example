# Example environment variables for running the connect agent server standalone.
# The Pearl middleware injects these automatically from the service template.
#
# The server reads the process environment only — it does not load a .env file.
# For local development, export these in your shell (e.g. `set -a; source
# .env; set +a` after copying this file, or plain `export VAR=...`).
# Usage is described under the "Development" section of README.md
# ("Run standalone (mimicking the Pearl runner)").

# ── Chain RPC endpoints ───────────────────────────────────────────────────────
# One per chain, formatted as CONNECTION_LEDGER_CONFIG_LEDGER_APIS_<CHAIN>_ADDRESS.
# <CHAIN> is the upper-cased chain name (e.g. GNOSIS, ETHEREUM, BASE).
CONNECTION_LEDGER_CONFIG_LEDGER_APIS_GNOSIS_ADDRESS=https://rpc.gnosischain.com

# ── Persistent workspace path ─────────────────────────────────────────────────
# Where the server writes .mcp.json, CLAUDE.md, settings, and the skill bundle.
# Required.
CONNECTION_CONFIGS_CONFIG_STORE_PATH=/path/to/persistent_data

# ── Safe contract addresses ───────────────────────────────────────────────────
# JSON object of {chain: address}. Chain keys are lower-cased on load.
CONNECTION_CONFIGS_CONFIG_SAFE_CONTRACT_ADDRESSES={"gnosis":"0x0000000000000000000000000000000000000000"}

# ── Fund requirements ─────────────────────────────────────────────────────────
# JSON object of {chain: {"agent"|"safe": {asset: threshold_in_wei}}}.
CONNECTION_CONFIGS_CONFIG_FUND_REQUIREMENTS={"gnosis":{"agent":{"0x0000000000000000000000000000000000000000":"1000000000000000000"}}}

# ── Log level ─────────────────────────────────────────────────────────────────
# One of: critical, error, warning, info, debug. Defaults to info.
CONNECTION_CONFIGS_CONFIG_LOG_LEVEL=info
